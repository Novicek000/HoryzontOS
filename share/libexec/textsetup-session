#!/bin/bash
# Tekstowa część instalatora HoryzontOS na tty1 (uruchamiana przez horyzontos-textsetup.service).
# Kody wyjścia programu: 0 = uruchom ponownie, 3 = zakończ (uruchom ponownie), 10 = Konsola odzyskiwania.
export PYTHONPATH=/usr/share/horyzontos
export LANG=C.UTF-8
dmesg -n 1 2>/dev/null
setterm --blank 0 --powerdown 0 </dev/tty1 >/dev/tty1 2>/dev/null
LANGARG="$(sed -n 's/.*horyzontos\.lang=\([a-z]*\).*/\1/p' /proc/cmdline)"
console() {
    plymouth quit 2>/dev/null
    chvt 1 2>/dev/null
    clear
    if [ "$LANGARG" = en ]; then
        echo "HoryzontOS Recovery Console"
        echo "Type 'exit' to return to Setup. Installed systems can be mounted under /mnt."
    else
        echo "Konsola odzyskiwania HoryzontOS"
        echo "Wpisz 'exit', aby wrócić do Instalatora. Zainstalowany system możesz zamontować w /mnt."
    fi
    echo
    PS1='[odzyskiwanie \W]# ' bash --norc -i
}
while true; do
    plymouth quit --retain-splash 2>/dev/null
    python3 -P -m horyzontos textsetup
    rc=$?
    case "$rc" in
        0|3) sync; systemctl reboot; exit 0;;
        10) console;;
        *)  echo "Instalator zakończył się błędem (kod $rc). Dziennik: /tmp/horyzontos-install.log" >/dev/tty1
            sleep 3
            console;;
    esac
done
