[Unit]
Description=Konfiguracja systemu HoryzontOS (instalator graficzny i pierwsze uruchomienie)
Documentation=https://github.com/Novicek000/HoryzontOS
After=systemd-user-sessions.service systemd-logind.service NetworkManager.service accounts-daemon.service
Wants=NetworkManager.service
Conflicts=getty@tty1.service
ConditionPathExists=/var/lib/horyzontos/stage

[Service]
Type=simple
ExecStart=/usr/libexec/horyzontos/setup-session
User=root
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SEAT=seat0 XDG_VTNR=1 HOME=/root
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
