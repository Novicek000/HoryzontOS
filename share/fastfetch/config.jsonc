// Ustawienia fastfetch dla HoryzontOS (ogólnosystemowe). Własne ustawienia: ~/.config/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/horyzontos/fastfetch-logo.txt",
        "color": { "1": "38;5;220", "2": "38;5;208", "3": "38;5;117" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": { "color": { "keys": "38;5;214", "title": "38;5;117" } }
}
